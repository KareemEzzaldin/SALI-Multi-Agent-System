    {
      "chunk_id": "CHK-MATH-501-math_grade5_term1_textbook.pdf_p24_001",
      "course_id": "MATH-501",
      "content": "\u0643\u062a\u0627\u0628 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u0644\u0644\u0635\u0641 \u0627\u0644\u062e\u0627\u0645\u0633 \u0627\u0644\u0627\u0628\u062a\u062f\u0627\u0626\u064a - \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u062f\u0631\u0627\u0633\u064a \u0627\u0644\u0623\u0648\u0644.\n\u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u0623\u0648\u0644\u0649: \u0627\u0644\u0643\u0633\u0648\u0631 \u0627\u0644\u0639\u0634\u0631\u064a\u0629 \u062d\u062a\u0649 \u0627\u0644\u062c\u0632\u0621 \u0645\u0646 \u0623\u0644\u0641.\n\u0627\u0644\u062f\u0631\u0633 \u0627\u0644\u062b\u0627\u0646\u064a: \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0643\u0633\u0648\u0631 \u0627\u0644\u0639\u0634\u0631\u064a\u0629:\n\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0643\u0633\u0631 \u0627\u0644\u0639\u0634\u0631\u064a 0.475 \u0646\u0642\u0648\u0644: \u0623\u0631\u0628\u0639\u0645\u0627\u0626\u0629 \u0648\u062e\u0645\u0633\u0629 \u0648\u0633\u0628\u0639\u0648\u0646 \u062c\u0632\u0621\u0627\u064b \u0645\u0646 \u0623\u0644\u0641.\n\u0644\u0645\u0642\u0627\u0631\u0646\u0629 \u0643\u0633\u0631\u064a\u0646 \u0639\u0634\u0631\u064a\u064a\u0646:\n1. \u0646\u0648\u0627\u0632\u0646 \u0623\u0648\u0644\u0627\u064b \u0639\u062f\u062f \u0627\u0644\u062e\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0634\u0631\u064a\u0629 \u0628\u0648\u0636\u0639 \u0623\u0635\u0641\u0627\u0631 \u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646 \u062f\u0648\u0646 \u0623\u0646 \u062a\u062a\u063a\u064a\u0631 \u0642\u064a\u0645\u0629 \u0627\u0644\u0643\u0633\u0631 (\u0645\u062b\u0644\u0627\u064b: 0.8 \u062a\u0635\u0628\u062d 0.800).\n2. \u0646\u0642\u0627\u0631\u0646 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0623\u0648\u0644\u0627\u064b.\n3. \u0625\u0630\u0627 \u062a\u0633\u0627\u0648\u062a \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0646\u0642\u0627\u0631\u0646 \u062c\u0632\u0621 \u0645\u0646 \u0639\u0634\u0631\u0629\u060c \u062b\u0645 \u062c\u0632\u0621 \u0645\u0646 \u0645\u0627\u0626\u0629\u060c \u062b\u0645 \u062c\u0632\u0621 \u0645\u0646 \u0623\u0644\u0641.\n\u062e\u0637\u0623 \u0634\u0627\u0626\u0639: \u0627\u0644\u0627\u0639\u062a\u0642\u0627\u062f \u0623\u0646 0.25 \u0623\u0643\u0628\u0631 \u0645\u0646 0.8 \u0644\u0623\u0646 25 \u0623\u0643\u0628\u0631 \u0645\u0646 8\u060c \u0648\u0627\u0644\u0635\u062d\u064a\u062d \u0623\u0646 0.8 = 0.80 \u0648\u0647\u064a \u0623\u0643\u0628\u0631 \u0645\u0646 0.25.\n\n\u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629: \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0623\u0639\u062f\u0627\u062f (\u0639.\u0645.\u0623 \u0648\u0645.\u0645.\u0623).\n\u0627\u0644\u062f\u0631\u0633 \u0627\u0644\u0631\u0627\u0628\u0639: \u0625\u064a\u062c\u0627\u062f \u0639.\u0645.\u0623 \u0648 \u0645.\u0645.\u0623:\n\u0644\u0625\u064a\u062c\u0627\u062f \u0627\u0644\u0639\u0627\u0645\u0644 \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u0627\u0644\u0623\u0643\u0628\u0631 \u0648\u0627\u0644\u0645\u0636\u0627\u0639\u0641 \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u0627\u0644\u0623\u0635\u063a\u0631 \u0644\u0644\u0639\u062f\u062f\u064a\u0646 6 \u0648 8:\n\u0646\u062d\u0644\u0644 6 = 2 \u00d7 3\n\u0646\u062d\u0644\u0644 8 = 2 \u00d7 2 \u00d7 2\n\u0627\u0644\u0639\u0627\u0645\u0644 \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u0627\u0644\u0623\u0643\u0628\u0631 (\u0639.\u0645.\u0623) = \u062d\u0627\u0635\u0644 \u0636\u0631\u0628 \u0627\u0644\u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u0623\u0648\u0644\u064a\u0629 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629 \u0641\u0642\u0637 = 2.\n\u0627\u0644\u0645\u0636\u0627\u0639\u0641 \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u0627\u0644\u0623\u0635\u063a\u0631 (\u0645.\u0645.\u0623) = \u0636\u0631\u0628 \u062c\u0645\u064a\u0639 \u0627\u0644\u0639\u0648\u0627\u0645\u0644 = 2 \u00d7 3 \u00d7 2 \u00d7 2 = 24.\n\u062a\u0646\u0628\u064a\u0647: \u0645.\u0645.\u0623 \u0647\u0648 \u0623\u0635\u063a\u0631 \u0639\u062f\u062f \u064a\u0642\u0628\u0644 \u0627\u0644\u0642\u0633\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0639\u062f\u062f\u064a\u0646\u060c \u0648\u0639.\u0645.\u0623 \u0647\u0648 \u0623\u0643\u0628\u0631 \u0639\u062f\u062f \u064a\u0642\u0633\u0645 \u0643\u0644\u0627 \u0627\u0644\u0639\u062f\u062f\u064a\u0646.\n\n\u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629: \u0636\u0631\u0628 \u0648\u0642\u0633\u0645\u0629 \u0627\u0644\u0643\u0633\u0648\u0631 \u0627\u0644\u0639\u0634\u0631\u064a\u0629.\n\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0636\u0631\u0628 \u0641\u064a \u0642\u0648\u0649 \u0627\u0644\u0639\u062f\u062f 10:\n\u0639\u0646\u062f \u0636\u0631\u0628 \u0639\u062f\u062f \u0639\u0634\u0631\u064a \u0641\u064a 10 \u062a\u062a\u062d\u0631\u0643 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u062e\u0627\u0646\u0629 \u0648\u0627\u062d\u062f\u0629 \u062c\u0647\u0629 \u0627\u0644\u064a\u0645\u064a\u0646: 3.45 \u00d7 10 = 34.5\n\u0639\u0646\u062f \u0627\u0644\u0636\u0631\u0628 \u0641\u064a 100 \u062a\u062a\u062d\u0631\u0643 \u062e\u0627\u0646\u062a\u064a\u0646 \u0644\u0644\u064a\u0645\u064a\u0646: 3.45 \u00d7 100 = 345\n\u0639\u0646\u062f \u0627\u0644\u0642\u0633\u0645\u0629 \u0639\u0644\u0649 10 \u062a\u062a\u062d\u0631\u0643 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u062c\u0647\u0629 \u0627\u0644\u064a\u0633\u0627\u0631: 45.2 \u00f7 10 = 4.52",
